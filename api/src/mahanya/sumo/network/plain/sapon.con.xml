    <connection from="north_in" to="west_out"/>
    <connection from="south_in" to="north_out"/>
    <connection from="south_in" to="east_out"/>
    <connection from="south_in" to="west_out"/>
    <connection from="east_in" to="north_out"/>
    <connection from="east_in" to="south_out"/>
    <connection from="east_in" to="west_out"/>
    <connection from="west_in" to="north_out"/>
    <connection from="west_in" to="south_out"/>
    <connection from="west_in" to="east_out"/>
</connections>
